          "name": "Estado del servicio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Servicio en línea\", () => pm.expect(pm.response.json().estado).to.eql(\"ok\"));",
                  "pm.test(\"Informa la versión\", () => pm.expect(pm.response.json().version).to.match(/^\\d+\\.\\d+\\.\\d+$/));",
                  "pm.test(\"Cabecera X-Content-Type-Options\", () => pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
