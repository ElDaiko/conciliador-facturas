# Seguridad de la cadena de suministro y reproducibilidad.

# Solo se instalan versiones publicadas hace más de 2 días: da tiempo a que
# se detecte y retire una versión comprometida antes de que llegue al proyecto.
min-release-age=2

# Un paquete con scripts de instalación no revisados hace fallar la instalación.
# Los revisados están en "allowScripts" de package.json (hoy, todos denegados).
strict-allow-scripts=true

# Falla con un mensaje claro si la versión de Node no cumple "engines".
engine-strict=true
