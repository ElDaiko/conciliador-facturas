        {
          "name": "Valores inválidos en algunas filas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200: las filas malas no rechazan el archivo\", () => pm.response.to.have.status(200));",
                  "const detalle = pm.response.json().detalle;",
                  "const estado = id => detalle.find(d => d.id_factura === id);",
                  "pm.test(\"FAC-0001 correcta (tarifas 0% y 4% normalizadas)\", () => pm.expect(estado(\"FAC-0001\").estado).to.eql(\"CORRECTA\"));",
                  "pm.test(\"Fecha, monto en letras y monto negativo marcados como VALOR_INVALIDO\", () => {",
                  "  for (const id of [\"FAC-0002\", \"FAC-0003\", \"FAC-0005\"]) {",
                  "    pm.expect(estado(id).causas.map(c => c.codigo), id).to.include(\"VALOR_INVALIDO\");",
                  "  }",
                  "});"
                ]
              }
            }
          ],
