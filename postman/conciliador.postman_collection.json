    {
      "name": "2. Conciliación con los archivos de prueba",
      "item": [
        {
          "name": "Conciliar muestra (50 facturas)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const resumen = r.resumen;",
                  "pm.test(\"50 registros de factura (48 únicos)\", () => {",
                  "  pm.expect(resumen.total_registros).to.eql(50);",
                  "  pm.expect(resumen.facturas_unicas).to.eql(48);",
                  "});",
                  "pm.test(\"32 correctas y 18 con inconsistencia\", () => {",
                  "  pm.expect(resumen.correctas).to.eql(32);",
                  "  pm.expect(resumen.con_inconsistencia).to.eql(18);",
                  "});",
                  "pm.test(\"Montos: sin contabilizar, no en firme y diferencias\", () => {",
                  "  pm.expect(resumen.monto_sin_contabilizar).to.eql(\"11521700.00\");",
                  "  pm.expect(resumen.monto_no_en_firme).to.eql(\"5572350.00\");",
                  "  pm.expect(resumen.monto_diferencias_calculo).to.eql(\"106500.00\");",
                  "});",
                  "pm.test(\"Conteo por causa: inconsistencias antes que advertencias\", () => {",
                  "  const tipos = resumen.por_causa.map(c => c.tipo);",
                  "  pm.expect(tipos.lastIndexOf(\"INCONSISTENCIA\")).to.be.below(tipos.indexOf(\"ADVERTENCIA\"));",
                  "  const conteo = Object.fromEntries(resumen.por_causa.map(c => [c.codigo, c.cantidad]));",
                  "  pm.expect(conteo).to.include({ DUPLICADA: 4, SIN_CONTABILIZAR: 4, CAMPO_VACIO: 3, TOTAL_DIFERENTE: 3, ESTADO_NO_CONTABILIZADO: 3, IVA_DIFERENTE: 2, VALOR_CONTABLE_DIFERENTE: 2 });",
                  "});",
                  "pm.test(\"Detalle con una fila por registro\", () => pm.expect(r.detalle).to.have.length(50));",
                  "pm.test(\"Trazabilidad de FAC-0006: IVA reportado vs esperado\", () => {",
                  "  const fac = r.detalle.find(d => d.id_factura === \"FAC-0006\");",
                  "  pm.expect(fac.estado).to.eql(\"CON_INCONSISTENCIA\");",
                  "  pm.expect(fac.causas).to.have.length(1);",
                  "  pm.expect(fac.causas[0]).to.include({ codigo: \"IVA_DIFERENTE\", valor_reportado: \"215000.00\", valor_esperado: \"190000.00\", diferencia: \"25000.00\" });",
                  "  pm.expect(fac.calculos.total_esperado).to.eql(\"3990000.00\");",
                  "});",
                  "pm.test(\"Duplicadas: se marcan todas las ocurrencias\", () => {",
                  "  const dup = r.detalle.filter(d => d.causas.some(c => c.codigo === \"DUPLICADA\")).map(d => d.id_factura).sort();",
                  "  pm.expect(dup).to.eql([\"FAC-0004\", \"FAC-0004\", \"FAC-0015\", \"FAC-0015\"]);",
                  "});",
                  "pm.test(\"Sin registro contable: FAC-0007, 0021, 0034 y 0042\", () => {",
                  "  const sin = r.detalle.filter(d => d.causas.some(c => c.codigo === \"SIN_CONTABILIZAR\")).map(d => d.id_factura);",
                  "  pm.expect(sin).to.eql([\"FAC-0007\", \"FAC-0021\", \"FAC-0034\", \"FAC-0042\"]);",
                  "});",
                  "pm.test(\"Una factura correcta no tiene causas\", () => {",
                  "  const fac = r.detalle.find(d => d.id_factura === \"FAC-0008\");",
                  "  pm.expect(fac.estado).to.eql(\"CORRECTA\");",
                  "  pm.expect(fac.causas).to.be.empty;",
                  "});",
                  "pm.test(\"Todos los registros contables tienen factura\", () => pm.expect(r.registros_contables_sin_factura).to.be.empty);",
                  "pm.test(\"Tolerancia informada\", () => pm.expect(r.tolerancia).to.eql(\"1.00\"));",
                  "pm.test(\"Respuesta financiera no se guarda en caché\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/conciliaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conciliaciones"
              ]
            },
            "description": "Flujo principal: debe producir 50 facturas, 32 correctas y 18 con inconsistencia.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "facturas",
                  "type": "file",
                  "src": "data/facturas.csv"
                },
                {
                  "key": "contabilidad",
                  "type": "file",
                  "src": "data/contabilidad.csv"
                }
              ]
            }
          },
          "response": []
        }
